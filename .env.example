# chflow-app / Vercel
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_SITE_URL=https://chflow-app.vercel.app
# Optional server-only quota values. Omit when the actual plan limit is unknown.
# SUPABASE_DB_QUOTA_BYTES drives both the usage-status DB capacity finding and the
# storage-cleanup cron's DB capacity alert. While it is unset the diagnostics report
# says DB_QUOTA_UNSET instead of silently passing as normal (500MB free tier = 524288000).
SUPABASE_DB_QUOTA_BYTES=
R2_STORAGE_QUOTA_BYTES=

# Scheduled jobs and protected operational APIs
CRON_SECRET=replace_with_random_secret
PUSH_DISPATCH_SECRET=replace_with_random_secret

# YouTube Live OAuth (server-only; do not expose as NEXT_PUBLIC_* variables)
YOUTUBE_OAUTH_CLIENT_ID=google_oauth_client_id.apps.googleusercontent.com
YOUTUBE_OAUTH_CLIENT_SECRET=google_oauth_client_secret
YOUTUBE_OAUTH_REFRESH_TOKEN=google_oauth_refresh_token

# 메인 주보 자동 수집(/api/bulletin/sync)용 UMS 계정 — Vercel production에도 반드시 설정
# 주보 열람만 가능한 저권한 전용 계정 사용 권장(관리자 계정 금지)
UMS_JUBO_USER_ID=ums_login_id
UMS_JUBO_PASSWORD=ums_login_password
# (fallback 허용: UMS_BULLETIN_USER_ID/PASSWORD 또는 UMS_USER_ID/PASSWORD)

# Optional bulletin/UMS integration
UMS_TEST_COOKIE=optional_debug_cookie

# Supabase Vault secrets, set in DB Vault, not in .env files
# chflow_push_dispatch_url=https://chflow-app.vercel.app/api/mobile/push-dispatch
# chflow_push_dispatch_secret=<same value as PUSH_DISPATCH_SECRET or CRON_SECRET>
