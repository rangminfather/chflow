# chflow-app / Vercel
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_SITE_URL=https://chflow-app.vercel.app

# Scheduled jobs and protected operational APIs
CRON_SECRET=replace_with_random_secret
PUSH_DISPATCH_SECRET=replace_with_random_secret

# Optional bulletin/UMS integration
UMS_TEST_COOKIE=optional_debug_cookie

# Supabase Vault secrets, set in DB Vault, not in .env files
# chflow_push_dispatch_url=https://chflow-app.vercel.app/api/mobile/push-dispatch
# chflow_push_dispatch_secret=<same value as PUSH_DISPATCH_SECRET or CRON_SECRET>
