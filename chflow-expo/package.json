{
  "name": "chflow-expo",
  "version": "1.1.5",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "release:preview": "node scripts/prepare-release.mjs",
    "release:patch": "node scripts/prepare-release.mjs patch --apply",
    "release:minor": "node scripts/prepare-release.mjs minor --apply",
    "release:major": "node scripts/prepare-release.mjs major --apply",
    "release:android": "npx eas-cli@latest build --platform android --profile production --non-interactive",
    "release:android:submit": "node scripts/verify-production-submit.mjs && npx eas-cli@latest submit --platform android --profile production --latest --non-interactive"
  },
  "dependencies": {
    "expo": "~54.0.33",
    "expo-application": "~7.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
