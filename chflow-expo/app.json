{
  "expo": {
    "name": "스마트명성",
    "slug": "chflow-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fff9f2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartmyungsung.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.smartmyungsung.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fff9f2"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "./plugins/with-adi-registration.js",
        { "snippet": "CFKKBMXYLJU2MAAAAAAAAAAAAA" }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "37e9eb7e-dfcb-426d-bb74-b47e5252e379"
      }
    },
    "owner": "rangminfather"
  }
}
