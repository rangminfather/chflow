    "@sparticuz/chromium-min": "^149.0.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.108.0",
    "cfb": "^1.2.2",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.10.1",
    "iconv-lite": "^0.7.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "next": "^16.2.10",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.0.227",
    "pptx-preview": "^1.0.7",
    "puppeteer-core": "^23.11.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
