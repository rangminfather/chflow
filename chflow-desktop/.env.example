# CHFlow 데스크톱 — 환경변수 예시 (실제 비밀값 커밋 금지)
# Vite는 VITE_ 접두사만 클라이언트에 노출한다.

# Supabase (공개 가능한 anon key만. service_role 절대 금지)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# 자체 호스팅 API 베이스 (username 로그인 / 첨부 프록시).
# 운영: https://chflow-app.vercel.app
VITE_CHFLOW_API_BASE_URL=https://chflow-app.vercel.app
